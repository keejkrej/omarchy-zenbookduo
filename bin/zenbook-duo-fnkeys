#!/usr/bin/env python3
"""Enable the Zenbook Duo keyboard's media/Fn row over USB and Bluetooth.

The keyboard keeps volume, brightness, and backlight on a vendor HID
interface (usage page 0xFF31). hid-generic ignores those reports, so the
top row looks like dead F-keys. USB pogo-pin is 0b05:1bf2 / 0b05:1b2c;
Bluetooth is 0b05:1bf3 (2025) / 0b05:1b2d (2024).

This daemon:
  1. Sends the ASUS Fn-lock feature report so mute/volume come through as
     normal consumer keys (hold Fn for F1-F12).
  2. Reads the remaining vendor reports: display brightness via Omarchy,
     F4 cycles keyboard backlight, mic is hold-to-talk, emoji opens the
     picker.
  3. Cycles keyboard backlight over the same HID feature report — there is
     no asus::kbd_backlight LED on this machine, so the kernel cannot turn
     the lamp off when the lid closes or the machine suspends.
  4. Turns that lamp off on lid-close and before suspend, then restores the
     saved level when the lid is open again. A logind delay inhibitor keeps
     suspend waiting until the off report has been sent.
"""

from __future__ import annotations

import array
import fcntl
import os
import select
import subprocess
import sys
import time
from pathlib import Path

USB_VENDOR = 0x0B05
USB_PRODUCTS = {0x1BF2, 0x1B2C}  # pogo-pin UX8406CA / UX8406MA
BT_PRODUCTS = {0x1BF3, 0x1B2D}  # Bluetooth UX8406CA / UX8406MA
ALL_PRODUCTS = USB_PRODUCTS | BT_PRODUCTS
USAGE_PAGE_ASUS = b"\x06\x31\xff"

# Feature report 0x5A, 15 payload bytes.
# fn_lock on  (00): media keys by default, hold Fn for F1-F12.
# fn_lock off (01): F1-F12 by default, hold Fn for media keys.
# hid-asus "ASUS Tech.Inc." handshake. Bluetooth often ignores backlight
# until this has been sent once after the HID device appears.
ASUS_HANDSHAKE = bytes.fromhex("5a4153555320546563682e496e632e00")
FNLOCK_REPORT = {
    True: bytes.fromhex("5ad04e00000000000000000000000000"),
    False: bytes.fromhex("5ad04e01000000000000000000000000"),
}
BACKLIGHT = {
    0: bytes.fromhex("5abac5c4000000000000000000000000"),
    1: bytes.fromhex("5abac5c4010000000000000000000000"),
    2: bytes.fromhex("5abac5c4020000000000000000000000"),
    3: bytes.fromhex("5abac5c4030000000000000000000000"),
}

# Vendor input report 0x5A, second byte is the usage.
USAGE_RELEASE = 0x00
USAGE_BRIGHTNESS_DOWN = 0x10
USAGE_BRIGHTNESS_UP = 0x20
USAGE_BATTERY = 0x3D
USAGE_FNLOCK = 0x4E
USAGE_MICMUTE = 0x7C
USAGE_EMOJI = 0x7E
USAGE_BACKLIGHT = 0xC7

BUS_USB = 0x03
BUS_BLUETOOTH = 0x05

LOCK_PATH = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "zenbook-duo-fnkeys.lock"
STATE_DIR = (
    Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
    / "omarchy-zenbookduo"
)
STATE_PATH = STATE_DIR / "kbd-backlight"
FNLOCK_PATH = STATE_DIR / "fn-lock"


def log(msg: str) -> None:
    print(msg, flush=True)


def hid_ioc(nr: int, length: int) -> int:
    # _IOC(_IOC_WRITE|_IOC_READ, 'H', nr, length)
    return 0xC0000000 | (length << 16) | (ord("H") << 8) | nr


def hid_set_feature(fd: int, report: bytes) -> None:
    last_err: OSError | None = None
    lengths = [len(report)]
    if len(report) < 64:
        lengths.append(64)
    for length in lengths:
        padded = report + bytes(length - len(report))
        buf = array.array("B", padded)
        try:
            fcntl.ioctl(fd, hid_ioc(0x06, len(buf)), buf, True)
            return
        except OSError as exc:
            last_err = exc
    assert last_err is not None
    raise last_err


def hid_info(path: Path) -> tuple[int, int, int] | None:
    """Return (bustype, vendor, product) for a hidraw node, or None."""
    info_path = Path("/sys/class/hidraw") / path.name / "device" / "uevent"
    try:
        text = info_path.read_text()
    except OSError:
        return None
    hid_id = None
    for line in text.splitlines():
        if line.startswith("HID_ID="):
            hid_id = line.split("=", 1)[1].strip()
            break
    if not hid_id:
        return None
    parts = hid_id.split(":")
    if len(parts) != 3:
        return None
    return int(parts[0], 16), int(parts[1], 16), int(parts[2], 16)


def is_asus_fn_hidraw(path: Path) -> bool:
    info = hid_info(path)
    if not info:
        return False
    bus, vendor, product = info
    if bus not in {BUS_USB, BUS_BLUETOOTH}:
        return False
    if vendor != USB_VENDOR or product not in ALL_PRODUCTS:
        return False
    desc = Path("/sys/class/hidraw") / path.name / "device" / "report_descriptor"
    try:
        return USAGE_PAGE_ASUS in desc.read_bytes()
    except OSError:
        return False


def find_fn_hidraw() -> Path | None:
    usb: list[Path] = []
    bluetooth: list[Path] = []
    for path in sorted(Path("/dev").glob("hidraw*")):
        if not is_asus_fn_hidraw(path):
            continue
        info = hid_info(path)
        if info and info[0] == BUS_USB:
            usb.append(path)
        else:
            bluetooth.append(path)
    if usb:
        return usb[0]
    if bluetooth:
        return bluetooth[0]
    return None


def load_backlight() -> int | None:
    try:
        value = int(STATE_PATH.read_text().strip())
    except (OSError, ValueError):
        return None
    return max(0, min(3, value))


def save_backlight(level: int) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    STATE_PATH.write_text(f"{level}\n")


def load_fnlock() -> bool:
    try:
        return FNLOCK_PATH.read_text().strip() not in {"0", "off", "false"}
    except OSError:
        return True


def save_fnlock(enabled: bool) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    FNLOCK_PATH.write_text("1\n" if enabled else "0\n")


def osd(icon: str, message: str, progress: int | None = None) -> None:
    cmd = ["omarchy-osd", "-i", icon, "-m", message]
    if progress is not None:
        cmd.extend(["-p", str(progress)])
    try:
        subprocess.Popen(
            cmd,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except OSError:
        pass


def osd_keyboard(level: int) -> None:
    percent = 0 if level <= 0 else int(round(level * 100 / 3))
    osd("keyboard", f"Backlight {level}/3", percent)


def toggle_emojis() -> None:
    try:
        subprocess.Popen(
            ["omarchy-shell", "shell", "toggle", "omarchy.emojis"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except OSError as exc:
        log(f"emoji picker: {exc}")


def voxtype_record(action: str) -> None:
    try:
        subprocess.Popen(
            ["voxtype", "record", action],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except OSError as exc:
        log(f"voxtype record {action}: {exc}")


def brightness_step(direction: str) -> None:
    arg = "+5%" if direction == "up" else "5%-"
    try:
        subprocess.Popen(
            ["omarchy-brightness-display", arg],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except OSError as exc:
        log(f"brightness {direction}: {exc}")


class Dictation:
    """Fn/Mic is hold-to-talk. Toggle/PTT otherwise stay Omarchy Hyprland defaults."""

    def __init__(self) -> None:
        self.source: str | None = None

    def start(self, source: str) -> None:
        if self.source:
            return
        voxtype_record("start")
        self.source = source
        log(f"dictation start ({source})")

    def stop(self, source: str | None = None) -> None:
        if not self.source:
            return
        if source is not None and source != self.source:
            return
        voxtype_record("stop")
        log(f"dictation stop ({self.source})")
        self.source = None


def bus_label(path: Path) -> str:
    info = hid_info(path)
    if not info:
        return "unknown"
    bus, _vendor, product = info
    kind = "usb" if bus == BUS_USB else "bluetooth" if bus == BUS_BLUETOOTH else f"bus {bus:#x}"
    return f"{kind} {product:04x}"


class Keyboard:
    def __init__(self, hidraw: Path, *, lid_closed: bool = False, sleeping: bool = False) -> None:
        self.path = hidraw
        self.fd = os.open(hidraw, os.O_RDWR)
        saved = load_backlight()
        self._have_level = saved is not None
        self.backlight = 0 if saved is None else saved
        self.lid_closed = lid_closed
        self.sleeping = sleeping
        self._lamp: int | None = None
        self._blanked = False
        self.fn_lock = load_fnlock()
        self._feature(ASUS_HANDSHAKE, "asus handshake")
        self._feature(FNLOCK_REPORT[self.fn_lock], "fn-lock")
        self._apply_lamp()
        held = ""
        if self.lid_closed:
            held = ", off while the lid is closed"
        elif self.sleeping:
            held = ", off for suspend"
        log(
            f"initialized {hidraw} ({bus_label(hidraw)}, "
            f"fn-lock {'on' if self.fn_lock else 'off'}, "
            f"backlight {self.backlight}{held})"
        )

    def _feature(self, report: bytes, what: str) -> None:
        if self.fd < 0:
            return
        try:
            hid_set_feature(self.fd, report)
        except OSError as exc:
            log(f"{what} failed on {self.path}: {exc}")

    def _apply_lamp(self) -> None:
        """Write the lamp level. Lid-closed and suspend force 0 and do not save it."""
        if self.fd < 0:
            return
        blank = self.lid_closed or self.sleeping
        if not blank and not self._have_level:
            return
        level = 0 if blank else self.backlight
        if self._lamp == level:
            return
        try:
            hid_set_feature(self.fd, BACKLIGHT[level])
        except OSError as exc:
            log(f"backlight failed on {self.path}: {exc}")
            return
        was_blanked = self._blanked
        self._lamp = level
        self._blanked = blank
        if blank and not was_blanked and self.backlight != 0:
            why = "lid closed" if self.lid_closed else "sleep"
            log(f"keyboard backlight off ({why})")
        elif was_blanked and not blank:
            log(f"keyboard backlight {level}")

    def set_power_state(self, lid_closed: bool, sleeping: bool) -> None:
        self.lid_closed = lid_closed
        self.sleeping = sleeping
        self._apply_lamp()

    def set_backlight(self, level: int) -> None:
        self.backlight = max(0, min(3, level))
        self._have_level = True
        save_backlight(self.backlight)
        self._apply_lamp()
        osd_keyboard(self.backlight)
        log(f"keyboard backlight {self.backlight}")

    def cycle_backlight(self) -> None:
        self.set_backlight((self.backlight + 1) % 4)

    def set_fn_lock(self, enabled: bool) -> None:
        self.fn_lock = enabled
        hid_set_feature(self.fd, FNLOCK_REPORT[self.fn_lock])
        save_fnlock(self.fn_lock)
        if self.fn_lock:
            osd("keyboard", "Fn lock: media keys")
            log("fn-lock on (media keys default, hold Fn for F1-F12)")
        else:
            osd("keyboard", "Fn lock: F1-F12")
            log("fn-lock off (F1-F12 default, hold Fn for media keys)")

    def toggle_fn_lock(self) -> None:
        self.set_fn_lock(not self.fn_lock)

    def close(self) -> None:
        fd = self.fd
        self.fd = -1
        if fd >= 0:
            os.close(fd)


def handle_report(data: bytes, kbd: Keyboard, talk: Dictation) -> None:
    if len(data) < 2 or data[0] != 0x5A:
        return
    usage = data[1]
    if usage == USAGE_RELEASE:
        talk.stop("fn9")
        return
    if usage == USAGE_BATTERY:
        return
    if usage == USAGE_FNLOCK:
        kbd.toggle_fn_lock()
        return
    if usage == USAGE_BACKLIGHT:
        kbd.cycle_backlight()
        return
    if usage == USAGE_BRIGHTNESS_DOWN:
        brightness_step("down")
        return
    if usage == USAGE_BRIGHTNESS_UP:
        brightness_step("up")
        return
    if usage == USAGE_MICMUTE:
        talk.start("fn9")
        return
    if usage == USAGE_EMOJI:
        toggle_emojis()
        return
    log(f"unhandled vendor usage 0x{usage:02x}: {data[:6].hex()}")


class PowerEvents:
    """Lid and suspend state from logind. Blank the lamp before releasing the sleep lock."""

    def __init__(self) -> None:
        self.lid_closed = False
        self.sleeping = False
        self._kbd: Keyboard | None = None
        self._inhibit_fd: int | None = None
        self._bus: object | None = None
        self._defer_inhibit = False
        self.on_settle = None

    def snapshot(self) -> tuple[bool, bool]:
        return self.lid_closed, self.sleeping

    def bind(self, kbd: Keyboard) -> None:
        self._kbd = kbd
        self._push()

    def unbind(self, kbd: Keyboard) -> None:
        if self._kbd is kbd:
            self._kbd = None

    def _push(self) -> None:
        if self._kbd is not None:
            self._kbd.set_power_state(self.lid_closed, self.sleeping)

    def note_lid(self, closed: bool) -> None:
        closed = bool(closed)
        if closed == self.lid_closed:
            return
        self.lid_closed = closed
        log("lid closed" if closed else "lid opened")
        self._push()

    def note_sleep(self, sleeping: bool) -> None:
        sleeping = bool(sleeping)
        changed = sleeping != self.sleeping
        self.sleeping = sleeping
        if sleeping:
            if changed:
                log("suspending")
                # Blank first, then drop the delay lock so suspend can proceed.
                self._push()
            self._release_inhibit()
            return
        if not changed:
            return
        log("resumed")
        # PrepareForSleep can arrive before the lid-open signal, and the open
        # signal itself is easy to miss across freeze. Re-read logind after
        # this handler returns so a blocking property read cannot deadlock.
        if self._defer_inhibit:
            from gi.repository import GLib

            GLib.idle_add(self._after_resume)
            return
        self._after_resume()

    def _after_resume(self) -> bool:
        self._refresh_lid()
        if self.on_settle is not None:
            self.on_settle()
        self._push()
        self._take_inhibit()
        return False

    def _refresh_lid(self) -> None:
        queried = self._query_lid()
        if queried is None or queried == self.lid_closed:
            return
        self.lid_closed = queried
        log("lid closed" if queried else "lid opened")

    def _query_lid(self) -> bool | None:
        bus = self._bus
        if bus is None:
            return None
        try:
            import dbus

            proxy = bus.get_object("org.freedesktop.login1", "/org/freedesktop/login1")
            props = dbus.Interface(proxy, "org.freedesktop.DBus.Properties")
            return bool(props.Get("org.freedesktop.login1.Manager", "LidClosed"))
        except Exception as exc:
            log(f"lid state: {exc}")
            return None

    def _take_inhibit(self) -> None:
        bus = self._bus
        if bus is None or self._inhibit_fd is not None:
            return
        try:
            proxy = bus.get_object("org.freedesktop.login1", "/org/freedesktop/login1")
            wrapped = proxy.Inhibit(
                "sleep",
                "zenbook-duo-fnkeys",
                "Turn keyboard backlight off",
                "delay",
                dbus_interface="org.freedesktop.login1.Manager",
            )
            self._inhibit_fd = wrapped.take()
        except Exception as exc:
            log(f"sleep inhibit: {exc}")

    def _release_inhibit(self) -> None:
        fd = self._inhibit_fd
        self._inhibit_fd = None
        if fd is None:
            return
        try:
            os.close(fd)
        except OSError as exc:
            log(f"sleep inhibit release: {exc}")

    def attach(self, bus: object) -> None:
        self._bus = bus
        self._defer_inhibit = True
        queried = self._query_lid()
        if queried is not None:
            self.lid_closed = queried
        log("lid closed" if self.lid_closed else "lid open")
        bus.add_signal_receiver(  # type: ignore[attr-defined]
            self._on_properties,
            signal_name="PropertiesChanged",
            dbus_interface="org.freedesktop.DBus.Properties",
            path="/org/freedesktop/login1",
        )
        bus.add_signal_receiver(  # type: ignore[attr-defined]
            self._on_prepare,
            signal_name="PrepareForSleep",
            dbus_interface="org.freedesktop.login1.Manager",
            path="/org/freedesktop/login1",
        )
        self._take_inhibit()

    def _on_properties(self, interface: str, changed: dict, _invalidated: list) -> None:
        if str(interface) != "org.freedesktop.login1.Manager":
            return
        if "LidClosed" not in changed:
            return
        self.note_lid(bool(changed["LidClosed"]))

    def _on_prepare(self, active: bool) -> None:
        self.note_sleep(bool(active))


def run_device(hidraw: Path, power: PowerEvents | None = None) -> None:
    lid_closed = False
    sleeping = False
    if power is not None:
        lid_closed, sleeping = power.snapshot()
    kbd = Keyboard(hidraw, lid_closed=lid_closed, sleeping=sleeping)
    if power is not None:
        power.bind(kbd)
    talk = Dictation()
    try:
        while True:
            ready, _, _ = select.select([kbd.fd], [], [])
            if kbd.fd in ready:
                data = os.read(kbd.fd, 64)
                if not data:
                    raise OSError("hidraw closed")
                handle_report(data, kbd, talk)
    finally:
        if power is not None:
            power.unbind(kbd)
        talk.stop()
        kbd.close()


def acquire_lock() -> int:
    fd = os.open(LOCK_PATH, os.O_CREAT | os.O_RDWR, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        log("another zenbook-duo-fnkeys is already running")
        os.close(fd)
        sys.exit(0)
    return fd


def _watch_blocking() -> None:
    denied_logged = False
    while True:
        hidraw = find_fn_hidraw()
        if hidraw is None:
            time.sleep(1.5)
            continue
        try:
            run_device(hidraw)
            denied_logged = False
        except PermissionError as exc:
            if not denied_logged:
                log(
                    f"{hidraw}: {exc} — Duo hidraw needs the overlay udev rule "
                    "with TAG+=uaccess (sudo bin/install-system.sh)"
                )
                denied_logged = True
        except (OSError, ValueError) as exc:
            log(f"{hidraw}: {exc}")
            denied_logged = False
        time.sleep(1.0)


def _watch_with_lid() -> None:
    from dbus.mainloop.glib import DBusGMainLoop
    from gi.repository import GLib
    import dbus

    DBusGMainLoop(set_as_default=True)
    bus = dbus.SystemBus()
    power = PowerEvents()
    holder: dict[str, object] = {"kbd": None, "talk": None}
    denied = {"logged": False}

    def drop_device(reason: str) -> bool:
        kbd = holder["kbd"]
        talk = holder["talk"]
        if not isinstance(kbd, Keyboard):
            return False
        holder["kbd"] = None
        holder["talk"] = None
        if isinstance(talk, Dictation):
            talk.stop()
        power.unbind(kbd)
        log(f"{kbd.path}: {reason}")
        kbd.close()
        return False

    def on_hid(_fd: int, cond: int) -> bool:
        kbd = holder["kbd"]
        talk = holder["talk"]
        if not isinstance(kbd, Keyboard) or not isinstance(talk, Dictation):
            return False
        if cond & GLib.IO_IN:
            try:
                data = os.read(kbd.fd, 64)
            except BlockingIOError:
                return True
            except OSError as exc:
                GLib.idle_add(drop_device, str(exc))
                return False
            if not data:
                GLib.idle_add(drop_device, "hidraw closed")
                return False
            try:
                handle_report(data, kbd, talk)
            except OSError as exc:
                GLib.idle_add(drop_device, str(exc))
                return False
        if cond & (GLib.IO_HUP | GLib.IO_ERR):
            GLib.idle_add(drop_device, "hidraw closed")
            return False
        return True

    def ensure_device() -> bool:
        if isinstance(holder["kbd"], Keyboard):
            return True
        hidraw = find_fn_hidraw()
        if hidraw is None:
            return True
        try:
            lid_closed, sleeping = power.snapshot()
            kbd = Keyboard(hidraw, lid_closed=lid_closed, sleeping=sleeping)
        except PermissionError as exc:
            if not denied["logged"]:
                log(
                    f"{hidraw}: {exc} — Duo hidraw needs the overlay udev rule "
                    "with TAG+=uaccess (sudo bin/install-system.sh)"
                )
                denied["logged"] = True
            return True
        except (OSError, ValueError) as exc:
            log(f"{hidraw}: {exc}")
            return True
        denied["logged"] = False
        talk = Dictation()
        holder["kbd"] = kbd
        holder["talk"] = talk
        power.bind(kbd)
        GLib.io_add_watch(kbd.fd, GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR, on_hid)
        return True

    power.on_settle = ensure_device
    try:
        power.attach(bus)
        GLib.timeout_add(1500, ensure_device)
        ensure_device()
        GLib.MainLoop().run()
    finally:
        power._release_inhibit()


def watch() -> None:
    acquire_lock()
    log("watching for Zenbook Duo USB/Bluetooth keyboard")
    while True:
        try:
            _watch_with_lid()
        except ImportError as exc:
            log(f"python dbus/gi missing ({exc}); lid will not blank the keyboard backlight")
            _watch_blocking()
            return
        except Exception as exc:
            log(f"lid watch failed ({exc}); retrying")
            time.sleep(1)
            continue
        log("lid watch stopped; retrying")
        time.sleep(1)


def init_only() -> int:
    hidraw = find_fn_hidraw()
    if hidraw is None:
        log("no Duo keyboard vendor hidraw found")
        return 1
    kbd = Keyboard(hidraw)
    kbd.close()
    return 0


def main() -> int:
    cmd = sys.argv[1] if len(sys.argv) > 1 else "watch"
    if cmd == "watch":
        watch()
        return 0
    if cmd == "init":
        return init_only()
    if cmd == "set-backlight":
        if len(sys.argv) < 3:
            log("usage: zenbook-duo-fnkeys set-backlight 0-3")
            return 2
        hidraw = find_fn_hidraw()
        if hidraw is None:
            log("no Duo keyboard vendor hidraw found")
            return 1
        kbd = Keyboard(hidraw)
        kbd.set_backlight(int(sys.argv[2]))
        kbd.close()
        return 0
    if cmd == "set-fn-lock":
        if len(sys.argv) < 3:
            log("usage: zenbook-duo-fnkeys set-fn-lock on|off|toggle")
            return 2
        hidraw = find_fn_hidraw()
        if hidraw is None:
            log("no Duo keyboard vendor hidraw found")
            return 1
        kbd = Keyboard(hidraw)
        arg = sys.argv[2].lower()
        if arg in {"on", "1", "true"}:
            kbd.set_fn_lock(True)
        elif arg in {"off", "0", "false"}:
            kbd.set_fn_lock(False)
        elif arg == "toggle":
            kbd.toggle_fn_lock()
        else:
            log("usage: zenbook-duo-fnkeys set-fn-lock on|off|toggle")
            kbd.close()
            return 2
        kbd.close()
        return 0
    log("usage: zenbook-duo-fnkeys [watch|init|set-backlight 0-3|set-fn-lock on|off|toggle]")
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(0)
