#!/bin/bash
# Reload Hyprland when the Zenbook Duo keyboard is snapped on or taken off.
# Monitor rules in hypr.duo read the USB pogo-pin state.
#
# Re-enabling eDP-2 after disable can leave the panel in the layout but black:
# DPMS stays off, no active workspace, or the eDP-2 backlight never commits.
# After a detach we wake the output, not only reload.
#
# Omarchy brightness keys only write intel_backlight (eDP-1). Keep the
# eDP-2 DRM backlight at the same percentage whenever the top panel changes.

LOCK="${XDG_RUNTIME_DIR:-/tmp}/zenbook-duo-keyboard-watch.lock"
SYNC_LOCK="${XDG_RUNTIME_DIR:-/tmp}/zenbook-duo-keyboard-sync.lock"
BACKLIGHT_LOCK="${XDG_RUNTIME_DIR:-/tmp}/zenbook-duo-backlight.lock"
BACKLIGHT_CLASS="${BACKLIGHT_CLASS:-/sys/class/backlight}"
USB_VENDOR="0b05"
BOTTOM_OUTPUT="eDP-2"

log() {
  printf '%s\n' "$*"
}

keyboard_attached() {
  local device vendor product
  for device in /sys/bus/usb/devices/*; do
    [[ -f $device/idVendor && -f $device/idProduct ]] || continue
    vendor=$(<"$device/idVendor")
    product=$(<"$device/idProduct")
    [[ $vendor == "$USB_VENDOR" ]] || continue
    case $product in
      1bf2 | 1b2c) return 0 ;;
    esac
  done
  return 1
}

hypr_dispatch() {
  hyprctl dispatch "$1" >/dev/null 2>&1 || true
}

bottom_monitor_json() {
  hyprctl monitors all -j 2>/dev/null | jq -c --arg output "$BOTTOM_OUTPUT" \
    '.[] | select(.name == $output)' 2>/dev/null
}

bottom_enabled() {
  local json
  json=$(bottom_monitor_json) || return 1
  [[ -n $json ]] || return 1
  jq -e '.disabled != true' <<<"$json" >/dev/null 2>&1
}

bottom_healthy() {
  local json actual backlight
  json=$(bottom_monitor_json) || return 1
  [[ -n $json ]] || return 1
  jq -e '.disabled != true and .dpmsStatus == true and ((.activeWorkspace.id // 0) != 0)' \
    <<<"$json" >/dev/null 2>&1 || return 1

  backlight=$(bottom_backlight_name) || return 0
  actual=$(<"$BACKLIGHT_CLASS/$backlight/actual_brightness")
  [[ -n $actual && $actual -gt 0 ]]
}

backlight_name_matching() {
  local glob=$1 path
  for path in "$BACKLIGHT_CLASS"/$glob; do
    [[ -e $path/brightness ]] || continue
    printf '%s\n' "${path##*/}"
    return 0
  done
  return 1
}

bottom_backlight_name() {
  backlight_name_matching '*eDP-2*'
}

top_backlight_name() {
  if [[ -e $BACKLIGHT_CLASS/intel_backlight/brightness ]]; then
    printf '%s\n' intel_backlight
    return 0
  fi
  backlight_name_matching '*eDP-1*'
}

# Map a raw backlight reading onto another device's range. Floor at 1 so a
# 0 write cannot leave eDP-2 in the "listed but black" state.
scaled_brightness() {
  local src_cur=$1 src_max=$2 dst_max=$3 dst
  dst=$((src_cur * dst_max / src_max))
  (( dst < 1 )) && dst=1
  (( dst > dst_max )) && dst=$dst_max
  printf '%s\n' "$dst"
}

set_backlight() {
  local device=$1 value=$2 path
  path="$BACKLIGHT_CLASS/$device/brightness"
  # brightnessctl talks to logind; only safe against the real sysfs tree.
  if [[ $BACKLIGHT_CLASS == /sys/class/backlight ]]; then
    brightnessctl -d "$device" set "$value" >/dev/null 2>&1 && return 0
  fi
  [[ -w $path ]] || return 1
  printf '%s\n' "$value" >"$path"
}

sync_bottom_backlight() {
  (
    flock 7
    local src dst src_cur src_max dst_max dst_cur dst_now
    src=$(top_backlight_name) || return 0
    dst=$(bottom_backlight_name) || return 0
    src_cur=$(<"$BACKLIGHT_CLASS/$src/brightness")
    src_max=$(<"$BACKLIGHT_CLASS/$src/max_brightness")
    dst_max=$(<"$BACKLIGHT_CLASS/$dst/max_brightness")
    dst_now=$(<"$BACKLIGHT_CLASS/$dst/brightness")
    [[ -n $src_cur && -n $src_max && $src_max -gt 0 && -n $dst_max && $dst_max -gt 0 ]] || return 0
    dst_cur=$(scaled_brightness "$src_cur" "$src_max" "$dst_max")
    [[ $dst_now == "$dst_cur" ]] && return 0
    set_backlight "$dst" "$dst_cur" || log "failed to set $dst to $dst_cur"
  ) 7>"$BACKLIGHT_LOCK"
}

ensure_bottom_workspace() {
  local json ws parked
  json=$(bottom_monitor_json) || return 0
  ws=$(jq -r '.activeWorkspace.id // 0' <<<"$json")
  [[ $ws != 0 && $ws != null && -n $ws ]] && return 0

  parked=$(hyprctl workspaces -j 2>/dev/null | jq -r --arg output "$BOTTOM_OUTPUT" \
    '[.[] | select(.monitor == $output) | .id][0] // empty')
  if [[ -n $parked ]]; then
    hypr_dispatch "hl.dsp.workspace.move({ workspace = $parked, monitor = \"$BOTTOM_OUTPUT\" })"
    return 0
  fi
  hypr_dispatch "hl.dsp.workspace.move({ workspace = \"emptyn\", monitor = \"$BOTTOM_OUTPUT\" })"
}

wake_bottom() {
  local tries=0
  while (( tries < 6 )); do
    bottom_healthy && return 0
    tries=$((tries + 1))

    if ! bottom_enabled; then
      hyprctl reload >/dev/null 2>&1 || true
      sleep 0.4
    fi

    hypr_dispatch "hl.dsp.dpms({ action = \"enable\", monitor = \"$BOTTOM_OUTPUT\" })"
    ensure_bottom_workspace
    sync_bottom_backlight

    if (( tries == 4 )); then
      hypr_dispatch 'hl.dsp.force_renderer_reload()'
      command -v omarchy-shell >/dev/null && omarchy-shell -q background refresh || true
    fi
    sleep 0.4
  done
  log "eDP-2 still black after wake (keyboard off)"
}

sync_state() {
  (
    flock -n 8 || exit 0
    local attached=1
    keyboard_attached || attached=0

    if (( attached )); then
      if bottom_enabled; then
        log "keyboard snapped on: disable $BOTTOM_OUTPUT"
        hyprctl reload >/dev/null 2>&1 || true
      fi
    else
      if ! bottom_enabled; then
        log "keyboard off: enable $BOTTOM_OUTPUT"
        hyprctl reload >/dev/null 2>&1 || true
        sleep 0.4
      fi
      if ! bottom_healthy; then
        log "wake $BOTTOM_OUTPUT"
        wake_bottom
      fi
    fi
    sync_bottom_backlight
  ) 8>"$SYNC_LOCK"
}

watch() {
  exec 9>"$LOCK"
  flock -n 9 || exit 0

  sync_state
  sync_bottom_backlight

  while true; do
    sleep 2
    sync_state
  done &

  local monitor=(udevadm monitor --udev --subsystem-match=usb --subsystem-match=backlight)
  if command -v stdbuf >/dev/null; then
    monitor=(stdbuf -oL "${monitor[@]}")
  fi

  while read -r line; do
    case $line in
      *'(backlight)')
        case $line in
          *intel_backlight* | *eDP-1*)
            sync_bottom_backlight
            ;;
        esac
        ;;
      *\ add\ * | *\ remove\ *)
        sleep 0.3
        sync_state
        ;;
    esac
  done < <("${monitor[@]}")
}

case "${1:-watch}" in
  sync) sync_state ;;
  sync-backlight) sync_bottom_backlight ;;
  scale)
    if (( $# != 4 )); then
      echo "Usage: $(basename "$0") scale SRC_CUR SRC_MAX DST_MAX" >&2
      exit 2
    fi
    scaled_brightness "$2" "$3" "$4"
    ;;
  watch) watch ;;
  *)
    echo "Usage: $(basename "$0") [sync|watch|sync-backlight|scale SRC_CUR SRC_MAX DST_MAX]" >&2
    exit 1
    ;;
esac
