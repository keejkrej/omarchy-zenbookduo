# ASUS Zenbook Duo detachable keyboard.
# Vendor HID reports for the Fn row and backlight live on hidraw.
#
# Omarchy no longer puts the login user in group `input`, so GROUP=input
# alone leaves these nodes unreadable. TAG+=uaccess is the same seat ACL
# Omarchy uses for Framework 16 QMK hidraw.
#
# USB pogo-pin has idVendor/idProduct on the USB parent. Bluetooth uhid
# does not, so match the HID device id instead (1bf3 2025, 1b2d 2024).

SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0b05", ATTRS{idProduct}=="1bf2", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0b05", ATTRS{idProduct}=="1b2c", MODE="0660", TAG+="uaccess"

SUBSYSTEM=="hidraw", KERNELS=="0005:0B05:1BF3.*", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="hidraw", KERNELS=="0005:0B05:1B2D.*", MODE="0660", TAG+="uaccess"
