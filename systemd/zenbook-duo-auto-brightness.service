[Unit]
Description=Zenbook Duo auto-brightness from the light sensor
After=graphical-session.target iio-sensor-proxy.service
PartOf=graphical-session.target

[Service]
ExecStart=%h/.config/zenbook/zenbook-duo-auto-brightness
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
